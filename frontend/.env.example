# Frontend Environment Variables Example
# Copy this file to .env or .env.local for local overrides if needed.
# For Vercel production deployment, set VITE_API_URL in the Vercel project environment variables settings.

# Render Backend API URL (Production Vercel configuration)
VITE_API_URL=https://sindhi-namkeen-shop.onrender.com/api

# For local development (optional, default falls back to '/api' which works with Vite dev proxy):
# VITE_API_URL=http://localhost:5000/api

# WhatsApp Business Click-to-Chat number (country code + number, digits only, no + or spaces)
VITE_WHATSAPP_NUMBER=919138592984
